; =============================================================================
; Asterisk HTTP + WebSocket for JsSIP (WSS on 8089 is on PJSIP transport;
; HTTP server still needed for Asterisk WS upgrade on some setups).
; Merge into /etc/asterisk/http.conf / rtp.conf as documented in INSTALL.md
; =============================================================================

; --- http.conf ---
;[general]
;enabled=yes
;bindaddr=0.0.0.0
;bindport=8088
;tlsenable=yes
;tlsbindaddr=0.0.0.0:8089
;tlscertfile=/etc/asterisk/keys/asterisk.crt
;tlsprivatekey=/etc/asterisk/keys/asterisk.key

; --- rtp.conf (ICE/WebRTC) ---
;[general]
;rtpstart=10000
;rtpend=20000
;icesupport=true
;stunaddr=stun.l.google.com:19302
