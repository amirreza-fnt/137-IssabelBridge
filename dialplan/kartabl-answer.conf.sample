; Kartabl answer + save recording/request after hangup.
; Install helper: replace any existing [137-kartabl-answer] block, then dialplan reload.

[137-kartabl-answer]
exten => _X.,1,NoOp(137 kartabl answer agent=${EXTEN} chan=${CHANNEL})
 same => n,Set(__137_AGENT=${EXTEN})
 same => n,Set(__137_SUBMITTED=0)
 same => n,Set(MEMBERINTERFACE=SIP/${EXTEN})
 same => n,Set(MONITOR_FILENAME=/var/spool/asterisk/monitor/137k-${UNIQUEID})
 same => n,MixMonitor(${MONITOR_FILENAME}.wav,b)
 same => n,Wait(1)
 same => n,SIPAddHeader(Call-Info: <sip:${EXTEN}@local>\;answer-after=0)
 ; g = continue in dialplan when called party hangs up (so AGI always runs)
 same => n,Dial(SIP/${EXTEN},120,tTrg)
 same => n,Goto(submit,1)

exten => h,1,NoOp(137 kartabl hangup agent=${137_AGENT})
 same => n,Goto(submit,1)

exten => submit,1,NoOp(137 kartabl submit agent=${137_AGENT} done=${137_SUBMITTED})
 same => n,GotoIf($["${137_SUBMITTED}"="1"]?done)
 same => n,Set(137_SUBMITTED=1)
 same => n,StopMixMonitor()
 same => n,AGI(137queue.php)
 same => n(done),Hangup()
