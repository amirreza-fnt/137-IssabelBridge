; === 137 overrides: MixMonitor post-submit + kartabl answer + IVR ===
; Installed by install-137-overrides.py

; ---------------------------------------------------------------------------
; Queue 8002:
;  - qagi: set MIXMON_POST so when recording ends → 137-on-record-end.php
;  - qcall: Queue WITHOUT AGI-on-answer (keep label so FreePBX chain stays intact)
; ---------------------------------------------------------------------------
[ext-queues]
exten => 8002,n(qagi),Set(__MIXMON_POST=/usr/bin/php -q /var/lib/asterisk/agi-bin/137-on-record-end.php ${UNIQUEID} ${CALLERID(num)})
exten => 8002,n(qcall),Queue(8002,${QOPTIONS},${QURL},${QAANNOUNCE},${QMAXWAIT},,,${QGOSUB},${QRULE},${QPOSITION})

; ---------------------------------------------------------------------------
; Backup hangup submit (if MixMonitor post did not run)
; ---------------------------------------------------------------------------
[137-hangup-submit]
exten => s,1,Gosub(137-hangup-submit,run,1)
 same => n,Return()

exten => run,1,NoOp(137 hangup-submit agent=${137_AGENT} qs=${QUEUESTATUS} done=${137_SUBMITTED})
 same => n,GotoIf($["${137_SUBMITTED}"="1"]?done)
 same => n,Set(137_SUBMITTED=1)
 same => n,StopMixMonitor()
 same => n,AGI(137queue.php)
 same => n(done),Return()

; ---------------------------------------------------------------------------
[137-kartabl-answer]
exten => _X.,1,NoOp(137 kartabl answer agent=${EXTEN} chan=${CHANNEL})
 same => n,Set(__137_AGENT=${EXTEN})
 same => n,Set(__137_SUBMITTED=0)
 same => n,ExecIf($["${EXTEN}"="2101"]?Set(MEMBERINTERFACE=PJSIP/${EXTEN}):Set(MEMBERINTERFACE=SIP/${EXTEN}))
 same => n,StopMixMonitor()
 same => n,Set(MONITOR_FILENAME=/var/spool/asterisk/monitor/137k-${UNIQUEID})
 same => n,MixMonitor(${MONITOR_FILENAME}.wav,b,/usr/bin/php -q /var/lib/asterisk/agi-bin/137-on-record-end.php ${UNIQUEID} ${CALLERID(num)} ${EXTEN})
 same => n,Set(CHANNEL(hangup_handler_push)=137-hangup-submit,s,1)
 same => n,Wait(1)
 ; 2101 = PJSIP WebRTC (kartabl JsSIP). Other extens = classic chan_sip (MicroSIP).
 same => n,GotoIf($["${EXTEN}"="2101"]?webrtc,1:sip,1)

exten => sip,1,SIPAddHeader(Call-Info: <sip:${137_AGENT}@local>\;answer-after=0)
 same => n,Dial(SIP/${137_AGENT},120,tTrg)
 same => n,Gosub(137-hangup-submit,run,1)
 same => n,Hangup()

exten => webrtc,1,NoOp(137 dial PJSIP WebRTC ${137_AGENT})
 same => n,Dial(PJSIP/${137_AGENT},120,tTrg)
 same => n,Gosub(137-hangup-submit,run,1)
 same => n,Hangup()

; ---------------------------------------------------------------------------
[ivr-1]
exten => 1,1,Set(__IVR_DIGIT_PRESSED=${EXTEN})
 same => n(ivrsel-1),Goto(ext-miscdests,1,1)
exten => 2,1,Set(__IVR_DIGIT_PRESSED=${EXTEN})
 same => n(ivrsel-2),Goto(ext-queues,8002,1)
exten => 3,1,Set(__IVR_DIGIT_PRESSED=${EXTEN})
 same => n(ivrsel-3),Goto(ext-miscdests,2,1)

[ivr-2]
exten => s,n(skip),Set(IVR_MSG=custom/ivr1)
exten => 1,1,Set(__IVR_DIGIT_PRESSED=${EXTEN})
 same => n(ivrsel-1),Goto(ext-miscdests,1,1)
exten => 2,1,Set(__IVR_DIGIT_PRESSED=${EXTEN})
 same => n(ivrsel-2),Goto(ext-queues,8002,1)
exten => 3,1,Set(__IVR_DIGIT_PRESSED=${EXTEN})
 same => n(ivrsel-3),Goto(ext-miscdests,2,1)
