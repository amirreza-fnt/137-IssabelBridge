; ivr-2 digit map for 137 (announcement file custom/ivr2 must match this text):
;  1 = ثبت درخواست (138)
;  2 = ارتباط با کارشناس (queue 8002)
;  3 = پیگیری (139)
;
; IMPORTANT: 137-full-overrides sets IVR_MSG=custom/ivr2 (NOT ivr1).
; Re-record in Issabel: Admin → System Recordings → custom/ivr2
;   "برای ثبت درخواست یک، ارتباط با کارشناس دو، پیگیری سه"

[ivr-2]
exten => 1,1,Set(__IVR_DIGIT_PRESSED=${EXTEN})
 same => n(ivrsel-1),Goto(ext-miscdests,1,1)

exten => 2,1,Set(__IVR_DIGIT_PRESSED=${EXTEN})
 same => n(ivrsel-2),Goto(ext-queues,8002,1)

exten => 3,1,Set(__IVR_DIGIT_PRESSED=${EXTEN})
 same => n(ivrsel-3),Goto(ext-miscdests,2,1)
